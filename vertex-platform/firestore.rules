rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones Helper de Gobernanza Global
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && 
        (request.auth.token.get('platformAdmin', false) == true || request.auth.token.get('superAdmin', false) == true);
    }

    function isStoreAdmin() {
      return isAuthenticated() && (
        isPlatformAdmin() ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('owner', false) == true
      );
    }

    // 1. Colecciones públicas del catálogo del storefront multi-tenant
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || (isStoreAdmin() && request.auth.token.get('tenantId', '') == resource.data.storeId);
    }

    match /attributes/{attributeId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || (isStoreAdmin() && request.auth.token.get('tenantId', '') == resource.data.storeId);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || (isStoreAdmin() && request.auth.token.get('tenantId', '') == resource.data.storeId);

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isPlatformAdmin() || (isStoreAdmin() && request.auth.token.get('tenantId', '') == resource.data.storeId);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || (isStoreAdmin() && request.auth.token.get('tenantId', '') == resource.data.storeId);
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || (isStoreAdmin() && request.auth.token.get('tenantId', '') == resource.data.storeId);
    }

    // 2. Protección por defecto de la factoría: cualquier ruta no declarada
    //    (stores, infrastructure_shards, billing_accounts, provisioning_queue,
    //     provisioning_logs, users, admin_roles, ...) exige isPlatformAdmin().
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
