rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // --- CATÁLOGO PÚBLICO STOREFRONT (Lectura pública universal en cualquier nivel) ---
    match /configuracion/{document=**} { allow read: if true; allow write: if isAuthenticated(); }
    match /attributes/{document=**} { allow read: if true; allow write: if isAuthenticated(); }
    match /products/{document=**} { allow read: if true; allow write: if isAuthenticated(); }
    match /categories/{document=**} { allow read: if true; allow write: if isAuthenticated(); }
    match /banners/{document=**} { allow read: if true; allow write: if isAuthenticated(); }

    // Estructuras anidadas por tenant / stores
    match /stores/{storeId}/{document=**} { allow read: if true; allow write: if isAuthenticated(); }
    match /tenants/{tenantId}/{document=**} { allow read: if true; allow write: if isAuthenticated(); }

    // Consultas comodín para subcolecciones o Collection Groups
    match /{path=**}/configuracion/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /{path=**}/attributes/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /{path=**}/products/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /{path=**}/categories/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /{path=**}/banners/{docId} { allow read: if true; allow write: if isAuthenticated(); }

    // Órdenes
    match /orders/{document=**} { allow create: if true; allow read, update: if isAuthenticated(); }
    match /{path=**}/orders/{orderId} { allow create: if true; allow read, update: if isAuthenticated(); }
  }
}
